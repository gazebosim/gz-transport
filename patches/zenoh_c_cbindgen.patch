--- cbindgen/cargo_manifest.bzl
+++ cbindgen/cargo_manifest.bzl
@@ -17,7 +17,7 @@
 load("@rules_rust//rust:rust_common.bzl", "CrateInfo", "TestCrateInfo")
 
